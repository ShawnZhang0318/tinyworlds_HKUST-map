{
  "name": "tinyworlds-hkust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source isometric pixel-art map of HKUST Clear Water Bay, based on tinyworlds by Nihey Takizawa.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/ShawnZhang0318/tinyworlds_HKUST.git" },
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "generate": "node scripts/generate.mjs",
    "pipeline:install": "npm ci --prefix vendor/tinyworlds-pipeline",
    "pipeline:build": "npm run build --prefix vendor/tinyworlds-pipeline"
  }
}
